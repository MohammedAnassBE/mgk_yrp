{
 "doctype": "DocType",
 "name": "MGK Delivery Challan",
 "module": "MGK YRP",
 "engine": "InnoDB",
 "autoname": "MGK-DC-.YY.-.#####",
 "naming_rule": "Expression",
 "is_submittable": 1,
 "track_changes": 1,
 "field_order": [
  "posting_date", "posting_time", "edit_posting_date_and_time", "is_return", "return_against",
  "from_location", "from_warehouse", "to_location", "to_warehouse", "is_internal_transfer", "transit_warehouse", "transfer_status", "process_name", "dc_number",
  "vehicle_number", "item_html", "item_details", "items", "total_qty", "total_declared_value", "close_status",
  "delivery_challan_close", "mgk_process_planning", "amended_from", "receipt_source_section", "purchase_order", "goods_received_note"
 ],
 "fields": [
  {"fieldname": "is_internal_transfer", "fieldtype": "Check", "label": "Internal Transfer", "read_only": 1, "no_copy": 1, "depends_on": "eval:doc.is_internal_transfer"},
  {"fieldname": "transit_warehouse", "fieldtype": "Link", "label": "Transit Warehouse", "options": "Warehouse", "read_only": 1, "no_copy": 1, "depends_on": "eval:doc.is_internal_transfer"},
  {"fieldname": "transfer_status", "fieldtype": "Select", "label": "Transfer Status", "options": "\nIn Transit\nPartly Transferred\nTransferred\nReturned", "read_only": 1, "no_copy": 1, "in_list_view": 1, "in_standard_filter": 1, "depends_on": "eval:doc.is_internal_transfer"},
  {
   "fieldname": "receipt_source_section",
   "fieldtype": "Section Break",
   "label": "Purchase Receipt",
   "collapsible": 1,
   "depends_on": "eval:doc.purchase_order || doc.goods_received_note"
  },
  {
   "fieldname": "purchase_order",
   "fieldtype": "Link",
   "label": "Purchase Order",
   "options": "MGK Purchase Order",
   "read_only": 1,
   "no_copy": 1,
   "depends_on": "eval:doc.purchase_order"
  },
  {
   "fieldname": "goods_received_note",
   "fieldtype": "Link",
   "label": "Goods Received Note",
   "options": "MGK Goods Received Note",
   "read_only": 1,
   "no_copy": 1,
   "depends_on": "eval:doc.goods_received_note"
  },
  {
   "fieldname": "item_html",
   "fieldtype": "HTML",
   "label": "Items"
  },
  {
   "fieldname": "item_details",
   "fieldtype": "Long Text",
   "label": "Item Details",
   "hidden": 1,
   "no_copy": 1
  },
  {
   "fieldname": "posting_date",
   "in_standard_filter": 1,
   "fieldtype": "Date",
   "label": "Posting Date",
   "default": "Today",
   "reqd": 1,
   "no_copy": 1,
   "read_only_depends_on": "eval:!doc.edit_posting_date_and_time"
  },
  {
   "fieldname": "posting_time",
   "fieldtype": "Time",
   "label": "Posting Time",
   "default": "Now",
   "reqd": 1,
   "no_copy": 1,
   "read_only_depends_on": "eval:!doc.edit_posting_date_and_time"
  },
  {
   "fieldname": "edit_posting_date_and_time",
   "fieldtype": "Check",
   "label": "Edit Posting Date and Time",
   "default": "0"
  },
  {
   "fieldname": "is_return",
   "fieldtype": "Check",
   "label": "Is Return",
   "read_only": 1,
   "default": "0"
  },
  {
   "fieldname": "return_against",
   "fieldtype": "Link",
   "label": "Return Against",
   "options": "MGK Delivery Challan",
   "read_only": 1,
   "depends_on": "eval:doc.is_return"
  },
  {
   "fieldname": "from_location",
   "in_standard_filter": 1,
   "fieldtype": "Link",
   "label": "From Location",
   "options": "Supplier",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.is_return"
  },
  {
   "fieldname": "from_warehouse",
   "fieldtype": "Link",
   "label": "From Warehouse",
   "options": "Warehouse",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.is_return"
  },
  {
   "fieldname": "to_location",
   "in_standard_filter": 1,
   "fieldtype": "Link",
   "label": "To Location",
   "options": "Supplier",
   "reqd": 1,
   "in_list_view": 1,
   "read_only_depends_on": "eval:doc.is_return"
  },
  {
   "fieldname": "to_warehouse",
   "fieldtype": "Link",
   "label": "To Warehouse",
   "options": "Warehouse",
   "reqd": 1,
   "read_only_depends_on": "eval:doc.is_return"
  },
  {
   "fieldname": "process_name",
   "in_standard_filter": 1,
   "fieldtype": "Link",
   "label": "Process",
   "options": "YRP Process",
   "reqd": 1,
   "in_list_view": 1,
   "read_only_depends_on": "eval:doc.is_return"
  },
  {"fieldname": "dc_number", "fieldtype": "Data", "label": "DC Number"},
  {"fieldname": "vehicle_number", "fieldtype": "Data", "label": "Vehicle Number"},
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Items",
   "options": "MGK Delivery Challan Item",
   "reqd": 1
  },
  {"fieldname": "total_qty", "fieldtype": "Float", "label": "Total Quantity", "read_only": 1},
  {
   "fieldname": "total_declared_value",
   "fieldtype": "Currency",
   "label": "Total Declared Value",
   "read_only": 1
  },
  {
   "fieldname": "close_status",
   "in_standard_filter": 1,
   "fieldtype": "Select",
   "label": "Close Status",
   "options": "\nOpen\nClosed\nReopening",
   "read_only": 1,
   "no_copy": 1,
   "allow_on_submit": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "delivery_challan_close",
   "fieldtype": "Link",
   "label": "Delivery Challan Close",
   "options": "MGK Delivery Challan Close",
   "read_only": 1,
   "no_copy": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "mgk_process_planning",
   "fieldtype": "Link",
   "label": "Process Planning",
   "options": "MGK Process Planning",
   "read_only": 1,
   "no_copy": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "MGK Delivery Challan",
   "read_only": 1,
   "no_copy": 1
  }
 ],
 "permissions": [
  {
   "role": "Stock User", "read": 1, "select": 1, "create": 1, "write": 1, "delete": 1,
   "submit": 1, "cancel": 1, "amend": 1, "report": 1, "export": 1, "print": 1, "email": 1, "share": 1
  },
  {
   "role": "Stock Manager", "read": 1, "select": 1, "create": 1, "write": 1, "delete": 1,
   "submit": 1, "cancel": 1, "amend": 1, "report": 1, "export": 1, "print": 1, "email": 1, "share": 1
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "sort_field": "modified",
 "sort_order": "DESC"
}
